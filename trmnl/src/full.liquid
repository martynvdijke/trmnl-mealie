<div class="layout layout--col gap">
  {% if IDX_0.image %}
  <div class="grid grid--cols-1">
    <img class="image image-cover image-dither rounded" src="{{ trml.plugin_settings.custom_fields_values.url }}{{ IDX_0.image }}" />
  </div>
  {% endif %}
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--large">{{ IDX_0.name }}</span>
    </div>
  </div>
  {% if IDX_0.description %}
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--small">{{ IDX_0.description }}</span>
    </div>
  </div>
  {% endif %}
  <div class="hr"></div>
  <div class="grid grid--cols-2">
    <div class="col col--start gap">
      {% if IDX_0.servings %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">Servings</span>
          <span class="value value--medium">{{ IDX_0.servings }}</span>
        </div>
      </div>
      {% endif %}
      {% if IDX_0.total_time %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">Total time</span>
          <span class="value value--medium">{{ IDX_0.total_time }}</span>
        </div>
      </div>
      {% endif %}
    </div>
    <div class="col col--start gap">
      {% if IDX_0.prep_time %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">Prep time</span>
          <span class="value value--medium">{{ IDX_0.prep_time }}</span>
        </div>
      </div>
      {% endif %}
      {% if IDX_0.cook_time %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="label">Cook time</span>
          <span class="value value--medium">{{ IDX_0.cook_time }}</span>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  <div class="hr"></div>
  {% if IDX_0.ingredients.size > 0 %}
  <div class="grid grid--cols-1">
    {% for ingredient in IDX_0.ingredients %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">{{ ingredient }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="hr"></div>
  {% endif %}
  {% if IDX_0.instructions.size > 0 %}
  <div class="grid grid--cols-1">
    {% for step in IDX_0.instructions %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Step {{ forloop.index }}</span>
        <span class="value value--small">{{ step }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Recipe of the Day</span>
</div>
